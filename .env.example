# Copy this file to .env, replace every REPLACE_ME value, then run
# `docker compose up --build -d`. Never commit the resulting .env file.

# Public Caddy addresses. A hostname without a scheme enables automatic HTTPS.
# The localhost defaults deliberately use HTTP for a frictionless first boot.
APP_ADDRESS=http://localhost
CADDY_DEFAULT_SNI=localhost
DASHBOARD_ADDRESS=http://dashboard.localhost
APP_PUBLIC_URL=http://localhost
DASHBOARD_PUBLIC_URL=http://dashboard.localhost
HTTP_PORT=80
HTTPS_PORT=443

# Caddy's outer login protects the app, proxied APIs, and official dashboard.
# Generate the hash with:
# docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext 'choose-a-password'
CADDY_BASIC_AUTH_USER=hermes
CADDY_BASIC_AUTH_HASH='REPLACE_ME_WITH_CADDY_BCRYPT_HASH'

# Internal service credentials. Caddy injects these upstream; they are never
# sent to the browser. Use independent random values, for example `openssl rand -hex 32`.
HERMES_API_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
KNOWLEDGE_API_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# The official dashboard has its own fail-closed auth gate in addition to Caddy.
# BASIC_AUTH_SECRET signs dashboard sessions and should be 32+ random bytes.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
HERMES_DASHBOARD_BASIC_AUTH_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Persistent host paths. Set HERMES_DATA_DIR to your existing ~/.hermes to reuse it.
HERMES_DATA_DIR=./data/hermes
KNOWLEDGE_DATA_DIR=./data/knowledge
# Must exactly match the local Obsidian vault name for obsidian:// links.
OBSIDIAN_VAULT_NAME=HERMESS
HERMES_UID=1000
HERMES_GID=1000
HERMES_DEFAULT_PROFILE=codex

# Official image pinned by tag and digest. Change HERMES_IMAGE deliberately
# after validating an upstream release against your persisted state.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.3@sha256:16788311e2fa3035456bdc1bafb8ec2b1777db64ebf020af9bb7eb73c3712c9e

# Provider credentials are optional and intentionally blank. Codex uses OAuth:
# docker compose exec --user hermes hermes hermes auth add openai-codex
# The login is persisted in HERMES_DATA_DIR/auth.json.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_LLM_API_KEY=

# Solari full-duplex voice is disabled until a dedicated OpenAI API project
# key is configured. Codex OAuth does not authenticate OpenAI Realtime API
# calls. Compose materializes this value at
# /run/secrets/openai_realtime_api_key with mode 0440; it is never injected into
# the frontend environment and must never use a NEXT_PUBLIC_ prefix.
SOLARI_REALTIME_ENABLED=false
SOLARI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_API_KEY=

# Local knowledge embedding. `auto` prefers sentence-transformers and falls
# back to the deterministic local hash embedder if the model is unavailable.
KNOWLEDGE_EMBEDDING_BACKEND=auto
KNOWLEDGE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
KNOWLEDGE_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
KNOWLEDGE_AUTO_INDEX=true
KNOWLEDGE_SCAN_INTERVAL_SECONDS=60
# Multipart framing ceiling for the server-side import proxy. The knowledge
# service enforces stricter per-file, file-count, and extracted-content limits.
KNOWLEDGE_IMPORT_MAX_FILES=12
KNOWLEDGE_IMPORT_MAX_FILE_BYTES=16777216
KNOWLEDGE_IMPORT_MAX_TOTAL_BYTES=67108864
KNOWLEDGE_IMPORT_MAX_EXTRACTED_BYTES=1800000
KNOWLEDGE_IMPORT_PARSER_TIMEOUT_SECONDS=30
KNOWLEDGE_IMPORT_BATCH_DEADLINE_SECONDS=90
# Bound retained source growth and preserve operational headroom on the shared
# knowledge volume. Both values are enforced again by the writer service.
KNOWLEDGE_IMPORT_ORIGINAL_QUOTA_BYTES=4294967296
KNOWLEDGE_IMPORT_FREE_SPACE_RESERVE_BYTES=1073741824

# Image build/runtime tuning.
FRONTEND_IMAGE=hermess-frontend:local
KNOWLEDGE_IMAGE=hermess-knowledge:local
EXTRACTOR_IMAGE=hermess-extractor:local
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
ALPINE_IMAGE=alpine:3.22
